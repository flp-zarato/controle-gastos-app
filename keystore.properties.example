# Copie para "keystore.properties" (raiz do projeto) se quiser gerar um APK de
# release assinado com uma chave própria, em vez de usar o APK de debug.
# Esse arquivo não é versionado (está no .gitignore).
storeFile=/caminho/para/sua/chave.jks
storePassword=sua_senha_da_keystore
keyAlias=seu_alias
keyPassword=sua_senha_da_chave
