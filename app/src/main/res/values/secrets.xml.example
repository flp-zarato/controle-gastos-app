<?xml version="1.0" encoding="utf-8"?>
<!--
  Copie este arquivo para "secrets.xml" (mesma pasta) e substitua pelo seu
  Client ID OAuth do tipo "Web application" criado no Google Cloud Console.
  Veja o passo a passo completo no README.md, seção "Configurar o Google Cloud".

  secrets.xml NÃO é versionado (está no .gitignore) — cada pessoa usa o seu.
-->
<resources>
    <string name="default_web_client_id" translatable="false">SEU_CLIENT_ID_AQUI.apps.googleusercontent.com</string>
</resources>
